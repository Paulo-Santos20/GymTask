# Firebase web app credentials — Firebase Console → Configurações do app → Seus apps → Web.
# Copie este arquivo para .env e preencha com os valores do seu projeto.
# Sem eles o app continua compilando e rodando: a tela de login apenas mostra
# "Configure o Firebase no arquivo .env para fazer login" (modo visitante continua disponível).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=SEU-PROJETO.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=SEU-PROJETO.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Web Push certificate (VAPID) — Firebase Console → Project Settings → Cloud Messaging →
# Web Push certificate → Generate key pairs. Necessário para o tópico `gytask-daily`.
VITE_FIREBASE_VAPID_KEY=

# Nutritionix search proxy (Cloud Function `nutritionProxy` — ver docs/DEPLOY_VERCEL.md).
# Vazio = busca externa de alimentos desativada; o banco local continua funcionando.
VITE_NUTRITION_PROXY_URL=

# Coach via Cloud Function (opcional): aponta as chamadas /api/coach/* para a URL de uma
# Cloud Function implantada em vez da origem que serve o app; vazio = comportamento atual.
# VITE_COACH_FUNCTION_URL=https://us-central1-SEU-PROJETO.cloudfunctions.net


# Mídia dos 1.324 exercícios (jpg + gif). São ~140 MB e nunca vão para o repositório nem para o
# build — em produção aponte para o dataset pinado no jsDelivr (mesmo valor do GitHub Pages);
# vazio = caminho relativo (img/ + gif/), que só funciona com a mídia servida ao lado do app
# (dev usa o proxy do vite para media/ — ver vite.config.js).
VITE_IMG_BASE=
VITE_GIF_BASE=
