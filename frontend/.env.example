# Firebase web app credentials — Firebase Console → Configurações do app → Seus apps → Web.
# Copie este arquivo para .env e preencha com os valores do seu projeto.
# Sem eles o app continua compilando e rodando: a tela de login apenas mostra
# "Configure o Firebase no arquivo .env para fazer login" (modo visitante continua disponível).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=SEU-PROJETO.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=SEU-PROJETO.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Nutritionix search proxy (Cloud Function `nutritionProxy` — ver docs/DEPLOY_VERCEL.md).
# Vazio = busca externa de alimentos desativada; o banco local continua funcionando.
VITE_NUTRITION_PROXY_URL=
