# GymTask Cloud Functions — environment template.
# Copy to `.env` (deployed) or `.env.local` (local/emulator) and fill in real values.
# Real env files are gitignored (functions/.gitignore + the root `.env` rule) — never commit
# keys, and never expose any of these to frontend/Vercel code: they are read server-side only.

# --- coach (xAI / Grok) ------------------------------------------------------
# Key from https://console.x.ai — used by the `coach` function as the Bearer token for
# https://api.x.ai/v1/chat/completions. Without it the function answers 400 with a clear
# message instead of crashing. (The api/ backend adapter reads the same XAI_API_KEY name
# from its own environment or from the admin credential store.)
XAI_API_KEY=

# Optional. Grok model to use; defaults to grok-3-mini when unset.
# Alternatives: grok-3, grok-3-fast, grok-4, grok-4-fast (see https://docs.x.ai for the
# list your account serves). An explicit model passed in the request body wins over this.
XAI_MODEL=grok-3-mini

# --- nutritionProxy (Nutritionix) ---------------------------------------------
# From https://developer.nutritionix.com — both are required; missing either makes the
# function answer 400 naming the variable. Used only in the x-app-id / x-app-key headers
# of the server-to-server call; never returned to any client.
NUTRITIONIX_APP_ID=
NUTRITIONIX_APP_KEY=

# --- pushDailyReminder (FCM daily reminder) ----------------------------------
# Optional runtime switch. Unset (or any value other than 0/false/off/no) means ON:
# deploying the function IS the opt-in — it only ever fires if you `firebase deploy`
# it, and this exists so you can switch the run off (set to 0) and redeploy without
# editing code. No credential to paste here: on Cloud Functions, admin.initializeApp()
# picks up the runtime's default credentials automatically (see README.md).
DAILY_REMINDER_ENABLED=
